{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hzerrad/themis/deploy/config/themis.schema.json",
  "properties": {
    "enrolledNamespaces": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "EnrolledNamespaces are the namespaces Themis acts on; alerts about others\nare rejected."
    },
    "intake": {
      "properties": {
        "bearerTokenFile": {
          "type": "string",
          "minLength": 1,
          "description": "BearerTokenFile holds the token Alertmanager must send as a bearer token."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "bearerTokenFile"
      ],
      "description": "Intake configures how alerts reach Themis."
    },
    "investigators": {
      "properties": {
        "bearerTokenFile": {
          "type": "string",
          "minLength": 1,
          "description": "BearerTokenFile holds the token investigators must send as a bearer token."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "bearerTokenFile"
      ],
      "description": "Investigators configures access to the gRPC API."
    },
    "api": {
      "properties": {
        "bearerTokenFile": {
          "type": "string",
          "minLength": 1,
          "description": "BearerTokenFile holds the admin token the API and UI require."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "bearerTokenFile"
      ],
      "description": "API configures access to the HTTP API and the UI."
    },
    "profiles": {
      "items": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 63,
            "minLength": 1,
            "description": "Name is a DNS label, for example rollout-regression."
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "description": "Priority orders profiles matching the same alert; higher wins. Unique,\nfrom 1."
          },
          "match": {
            "properties": {
              "alertNames": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "AlertNames lists the alertname values that match."
              },
              "labels": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object",
                "description": "Labels must all be present on the alert with these values."
              },
              "targetKinds": {
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z0-9]*(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
                },
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "TargetKinds lists the resolved target kinds that match, as Kind.group."
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "alertNames",
              "targetKinds"
            ],
            "description": "Match decides which alerts belong to this profile."
          },
          "evidence": {
            "properties": {
              "initial": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true,
                "description": "Initial templates are collected before the investigation starts."
              },
              "allowed": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "Allowed templates may be requested during the investigation."
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "allowed"
            ],
            "description": "Evidence lists the templates investigations of this profile may use."
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true,
            "description": "Capabilities are the remediations proposals may name; none means\ndiagnosis only."
          },
          "investigation": {
            "properties": {
              "maxSteps": {
                "type": "integer",
                "minimum": 1
              },
              "maxEvidenceRequests": {
                "type": "integer",
                "minimum": 1
              },
              "timeout": {
                "type": "string",
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "description": "Investigation bounds each investigation; zero fields take defaults."
          },
          "policy": {
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "guarded",
                  "observe"
                ]
              },
              "rules": {
                "items": {
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "when": {
                      "type": "string",
                      "minLength": 1
                    },
                    "decision": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "deny",
                        "require_approval"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "name",
                    "when",
                    "decision"
                  ],
                  "description": "PolicyRule decides when its CEL expression holds."
                },
                "type": "array"
              },
              "approvalTimeout": {
                "type": "string",
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "description": "Policy decides whether proposed actions run, wait for approval, or not."
          },
          "verification": {
            "properties": {
              "window": {
                "type": "string",
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                "description": "Window is how long to watch the target after an action."
              },
              "stability": {
                "type": "string",
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                "description": "Stability is how long the target must stay healthy within the window."
              }
            },
            "additionalProperties": false,
            "type": "object",
            "description": "Verification measures an action's outcome; zero fields take defaults."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "priority",
          "match",
          "evidence"
        ],
        "description": "Profile is one incident class and the alerts that belong to it."
      },
      "type": "array",
      "minItems": 1,
      "description": "Profiles classify alerts into incident classes; the highest priority match\nwins."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "enrolledNamespaces",
    "intake",
    "investigators",
    "api",
    "profiles"
  ],
  "title": "Themis configuration",
  "description": "Config is the root of the configuration file."
}
